{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "deploy:migrate": "prisma migrate deploy",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/order-calculations.test.mts tests/checkout.test.mts tests/client-data.test.mts tests/menu-management.test.mts tests/deal-management.test.mts tests/coupon-management.test.mts tests/dashboard.test.mts",
    "test:menu:db": "node --experimental-strip-types tests/menu-database.mts",
    "test:deals:db": "node --experimental-strip-types tests/deal-database.mts",
    "test:checkout:db": "node --experimental-strip-types tests/checkout-database.mts",
    "seed:dashboard": "node --experimental-strip-types scripts/seed-dashboard-data.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
