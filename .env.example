# Neon pooled PostgreSQL connection string. Keep the real value secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Generate a unique value with: openssl rand -base64 32
JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional. Product images can still be entered as Cloudinary HTTPS URLs when
# these are absent; these variables enable direct unsigned uploads in the UI.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
